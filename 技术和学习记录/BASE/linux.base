views:
  - type: table
    name: Linux学习
    filters:
      or:
        - file.tags.containsAny("linux", "操作系统", "寄存器", "汇编")
    order:
      - file.name
      - tags
    sort:
      - property: file.basename
        direction: ASC
    columnSize:
      file.name: 187
  - type: table
    name: gdb相关
    filters:
      and:
        - file.tags.contains("gdb")
    order:
      - file.name
      - tags
  - type: table
    name: 大模型学习
    filters:
      and:
        - file.tags.contains("ai")
  - type: table
    name: 文件系统
    filters:
      and:
        - file.tags.contains("文件系统")
  - type: table
    name: 电子书
    filters:
      and:
        - file.tags.contains("pdf")
  - type: table
    name: Skill
    filters:
      and:
        - file.tags.contains("skill")
  - type: table
    name: Cassandra
    filters:
      and:
        - file.tags.contains("Cassandra")
  - type: table
    name: git
    filters:
      and:
        - file.tags.contains("lazygit")
  - type: table
    name: ai
    filters:
      and:
        - file.tags.contains("ai")
  - type: table
    name: math
    filters:
      and:
        - file.tags.contains("math")
  - type: table
    name: 卡片盒
    filters:
      and:
        - zettelkastenNo.startsWith("2")
    order:
      - file.name
      - zettelkastenNo
    columnSize:
      file.name: 191
  - type: table
    name: 线性代数学习
    filters:
      and:
        - zettelkastenNo.startsWith("1")
    order:
      - file.name
      - zettelkastenNo
      - zettelkastenUp
    sort:
      - property: zettelkastenNo
        direction: ASC
    columnSize:
      file.name: 142
  - type: table
    name: 研究房市数据
    filters:
      and:
        - zettelkastenNo.startsWith("3")
